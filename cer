<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>مغامرة التاريخ مع المعلمة وفاء</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;700;900&display=swap" rel="stylesheet">
<style>
:root{--lapis:#12355b;--deep:#0b2342;--gold:#e0a93b;--sand:#f6e7c8;--ink:#1d2433;--ok:#1f8a5b;--bad:#b5412b;--turq:#1f8a8a;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{height:100%}
body{margin:0;min-height:100%;font-family:'Cairo','Segoe UI',Tahoma,Arial,sans-serif;font-size:20px;color:var(--ink);
background:linear-gradient(160deg,#0b2342 0%,#12556b 55%,#c98d2b 130%) fixed;display:flex;justify-content:center;padding:14px}
main{width:100%;max-width:640px}
.card{background:var(--sand);border:5px solid var(--gold);border-radius:28px;padding:22px 18px;box-shadow:0 14px 34px rgba(0,0,0,.35);text-align:center}
.hide{display:none!important}
h1{font-size:2rem;margin:.2em 0;color:var(--lapis);font-weight:900;line-height:1.5}
h2{font-size:1.35rem;line-height:1.8;margin:.4em 0 .8em;color:var(--deep)}
.tag{display:inline-block;background:#cfe3df;border-radius:999px;padding:4px 16px;font-size:.9rem;margin:4px}
.mascot{font-size:4.2rem;line-height:1;display:inline-block;animation:bob 2.4s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-8px) rotate(-4deg)}}
button{font-family:inherit;font-size:1.15rem;font-weight:700;cursor:pointer;border:0;border-radius:18px;padding:14px 20px;min-height:54px;transition:transform .12s,box-shadow .12s}
button:active{transform:scale(.95)}
button:focus-visible,input:focus-visible{outline:4px solid var(--turq);outline-offset:2px}
.go{background:var(--lapis);color:#fff;box-shadow:0 5px 0 var(--deep);width:100%;margin-top:12px}
.alt{background:var(--gold);color:var(--deep);box-shadow:0 5px 0 #a87a1c;margin:6px 4px}
.opt{display:block;width:100%;margin:10px 0;background:#fff;color:var(--ink);border:3px solid #d8c18c;text-align:right;box-shadow:0 4px 0 #d8c18c}
.opt:hover:not(:disabled){border-color:var(--turq)}
.opt.ok{background:#d6f0e2;border-color:var(--ok);color:#0e5a3a}
.opt.no{background:#f7d9d2;border-color:var(--bad);color:#7a2616}
.bar{display:flex;justify-content:space-between;align-items:center;font-weight:700;margin-bottom:8px;gap:8px}
.prog{height:12px;background:#e4d3a8;border-radius:9px;overflow:hidden;margin-bottom:12px}
.prog i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--turq),var(--gold));transition:width .4s}
.mute{background:transparent;box-shadow:none;min-height:44px;padding:6px 12px;font-size:1.4rem}
#fb{margin-top:10px;padding:12px;border-radius:16px;font-weight:700;line-height:1.8}
#fb.ok{background:#d6f0e2;color:#0e5a3a}#fb.no{background:#f7d9d2;color:#7a2616}
.big{font-size:3rem;font-weight:900;color:var(--lapis);margin:0}
input{font-family:inherit;font-size:1.15rem;width:100%;padding:12px;border-radius:14px;border:3px solid #d8c18c;text-align:center;margin:8px 0}
.stats{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
.stats span{background:#fff;border-radius:14px;padding:6px 14px;font-weight:700}
#cert{margin-top:18px;border:8px double var(--gold);background:#fffaf0;border-radius:18px;padding:22px 12px}
#cert h3{font-size:1.7rem;color:var(--lapis);margin:.2em 0;font-weight:900}
#cert .nm{font-size:1.8rem;font-weight:900;color:var(--bad);margin:.3em 0;min-height:1.6em}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media print{
 body{background:#fff;display:block;padding:0}
 main>*:not(#end){display:none!important}
 #end>*:not(#cert){display:none!important}
 #end{border:0;box-shadow:0;background:#fff;padding:0}
 #cert{margin:0;border-width:10px}
 @page{size:landscape;margin:12mm}
}
</style>
</head>
<body>
<main>

<section id="home" class="card">
  <div class="mascot" aria-hidden="true">👑</div>
  <p style="margin:0;color:#8a6420;font-weight:700">رحلة عبر الحضارة المصرية</p>
  <h1>مغامرة التاريخ مع المعلمة وفاء</h1>
  <p>اكتشف عصر الدولة الحديثة في ١٣ تحديًا ممتعًا. هل أنت مستعد لرحلة الفراعنة؟</p>
  <span class="tag">التاريخ المصري القديم</span><span class="tag">الصف الأول الثانوي</span>
  <p style="margin:.6em 0 0">إعداد المعلمة: وفاء إبراهيم</p>
  <button class="go" id="startBtn">ابدأ المغامرة 🏺</button>
</section>

<section id="game" class="card hide" aria-live="polite">
  <div class="bar">
    <span id="num">السؤال ١ من ١٣</span>
    <span id="sc">⭐ 0</span>
    <button class="mute" id="muteBtn" aria-label="كتم الصوت أو تشغيله">🔊</button>
  </div>
  <div class="prog"><i id="pg"></i></div>
  <div class="mascot" id="mas" style="font-size:3rem" aria-hidden="true">🐪</div>
  <h2 id="qt"></h2>
  <div id="opts"></div>
  <div id="fb" class="hide" role="status"></div>
  <button class="go hide" id="nextBtn">السؤال التالي</button>
</section>

<section id="end" class="card hide">
  <div class="mascot" aria-hidden="true">🏆</div>
  <h1>انتهت المغامرة!</h1>
  <label for="nameIn" style="font-weight:700">اكتب اسمك لتظهر على الشهادة</label>
  <input id="nameIn" maxlength="40" placeholder="اسم الطالب أو الطالبة" autocomplete="name">
  <p class="big" id="final"></p>
  <div class="stats"><span id="pct"></span><span id="okc"></span><span id="badc"></span></div>
  <p id="msg" style="font-weight:700;line-height:1.8"></p>
  <div id="cert">
    <div style="font-size:2.4rem" aria-hidden="true">👑 𓂀 👑</div>
    <h3>شهادة تقدير وتفوق</h3>
    <p style="margin:.2em">تُمنح هذه الشهادة إلى</p>
    <div class="nm" id="certName"></div>
    <p id="certTxt" style="line-height:1.9;margin:.3em 0"></p>
    <p style="margin:.6em 0 0;font-weight:700">المعلمة: وفاء إبراهيم</p>
    <p style="margin:0;font-size:.85rem">التاريخ المصري القديم · الصف الأول الثانوي</p>
  </div>
  <button class="alt" id="printBtn">🖨️ طباعة / حفظ PDF</button>
  <button class="alt" id="again">🔄 إعادة اللعب</button>
</section>

</main>
<script>
/* ===== الأسئلة: عدّلها من هنا =====
 q: نص السؤال | o: الاختيارات | a: رقم الإجابة الصحيحة (يبدأ من 0) | e: التفسير */
const QUESTIONS = [
 {q:"بدأ عصر الدولة الحديثة بعد طرد الهكسوس من مصر.", o:["صح","خطأ"], a:0, e:"طرد الملك أحمس الأول الهكسوس وبدأ بذلك عصر الدولة الحديثة."},
 {q:"من الملك الذي طرد الهكسوس وأسّس الأسرة الثامنة عشرة؟", o:["أحمس الأول","تحتمس الثالث","رمسيس الثاني","أمنحتب الثالث"], a:0, e:"الملك أحمس الأول هو مؤسس الأسرة الثامنة عشرة."},
 {q:"ما اسم عاصمة الهكسوس في شرق الدلتا؟", o:["طيبة","أواريس","منف","أخيتاتون"], a:1, e:"كانت أواريس (تل الضبعة) عاصمة الهكسوس."},
 {q:"أي ملكة أرسلت بعثة تجارية سلمية إلى بلاد بونت؟", o:["نفرتيتي","حتشبسوت","تيي","نفرتاري"], a:1, e:"أرسلت حتشبسوت بعثة بونت وسجّلتها على جدران معبد الدير البحري."},
 {q:"أين يقع معبد الملكة حتشبسوت الشهير؟", o:["الدير البحري","أبو سمبل","الكرنك","هابو"], a:0, e:"معبدها الجنائزي في الدير البحري غرب طيبة."},
 {q:"انتصر تحتمس الثالث على الكنعانيين في معركة:", o:["قادش","مجدو","الحفير","أواريس"], a:1, e:"كانت معركة مجدو من أشهر انتصارات تحتمس الثالث في آسيا."},
 {q:"ما الإله الذي دعا الملك أمنحتب الرابع (إخناتون) إلى عبادته؟", o:["آمون","رع","آتون","أوزير"], a:2, e:"دعا إخناتون إلى عبادة آتون، قرص الشمس."},
 {q:"ما اسم العاصمة التي بناها إخناتون في موقع تل العمارنة؟", o:["أخيتاتون","طيبة","منف","بر رمسيس"], a:0, e:"سمّاها أخيتاتون، أي أفق آتون."},
 {q:"أعاد توت عنخ آمون عبادة آمون ونقل العاصمة إلى طيبة.", o:["صح","خطأ"], a:0, e:"ترك توت عنخ آمون عبادة آتون وعاد إلى عبادة آمون."},
 {q:"أين دُفن معظم ملوك الدولة الحديثة؟", o:["هرم الجيزة","وادي الملوك","سقارة","دهشور"], a:1, e:"حُفرت مقابرهم في الصخر بوادي الملوك غرب طيبة."},
 {q:"قاد رمسيس الثاني الجيش المصري ضد الحيثيين في معركة:", o:["مجدو","قادش","كرمة","نابتا"], a:1, e:"دارت معركة قادش بين رمسيس الثاني والحيثيين."},
 {q:"عقد رمسيس الثاني معاهدة سلام مع الحيثيين بعد معركة قادش.", o:["صح","خطأ"], a:0, e:"وهي من أقدم معاهدات السلام المكتوبة المعروفة في التاريخ."},
 {q:"من الملك الذي صدّ هجمات شعوب البحر وسجّل انتصاره في معبد مدينة هابو؟", o:["رمسيس الثالث","سيتي الأول","حور محب","تحتمس الأول"], a:0, e:"سجّل رمسيس الثالث انتصاره على شعوب البحر على جدران معبده بمدينة هابو."}
];
const MASCOTS=["🐪","🐍","🏺","👑","🦅","🐈"];
const $=id=>document.getElementById(id);
let cur=0,score=0,right=0,wrong=0,locked=false,muted=false,ctx=null;

function tone(freqs,dur){
 if(muted)return;
 try{
  ctx=ctx||new (window.AudioContext||window.webkitAudioContext)();
  freqs.forEach((f,i)=>{
   const o=ctx.createOscillator(),g=ctx.createGain(),t=ctx.currentTime+i*dur;
   o.frequency.value=f;o.type="triangle";o.connect(g);g.connect(ctx.destination);
   g.gain.setValueAtTime(.18,t);g.gain.exponentialRampToValueAtTime(.001,t+dur);
   o.start(t);o.stop(t+dur);
  });
 }catch(e){}
}
function show(id){["home","game","end"].forEach(s=>$(s).classList.toggle("hide",s!==id));window.scrollTo(0,0)}

function render(){
 locked=false;
 const d=QUESTIONS[cur];
 $("num").textContent="السؤال "+(cur+1)+" من "+QUESTIONS.length;
 $("pg").style.width=(cur/QUESTIONS.length*100)+"%";
 $("sc").textContent="⭐ "+score;
 $("mas").textContent=MASCOTS[cur%MASCOTS.length];
 $("qt").textContent=d.q;
 $("fb").className="hide";$("nextBtn").classList.add("hide");
 $("nextBtn").textContent=cur===QUESTIONS.length-1?"عرض النتيجة 🏆":"السؤال التالي";
 const box=$("opts");box.innerHTML="";
 d.o.forEach((t,i)=>{
  const b=document.createElement("button");b.className="opt";b.textContent=t;
  b.onclick=()=>answer(i,b);box.appendChild(b);
 });
}
function answer(i,btn){
 if(locked)return;locked=true;
 const d=QUESTIONS[cur],btns=[...document.querySelectorAll(".opt")];
 btns.forEach(b=>b.disabled=true);
 const fb=$("fb");
 if(i===d.a){
  score++;right++;btn.classList.add("ok");tone([523,659,784],.12);
  fb.textContent="✅ أحسنت! إجابة صحيحة. "+d.e;fb.className="ok";
 }else{
  wrong++;btn.classList.add("no");btns[d.a].classList.add("ok");tone([220,165],.2);
  fb.textContent="❌ حاول مرة أخرى في السؤال القادم. "+d.e;fb.className="no";
 }
 $("sc").textContent="⭐ "+score;
 $("nextBtn").classList.remove("hide");$("nextBtn").focus();
}
function finish(){
 const n=QUESTIONS.length,p=Math.round(score/n*100);
 $("pg").style.width="100%";
 $("final").textContent=score+" / "+n;
 $("pct").textContent="النسبة: "+p+"%";
 $("okc").textContent="✅ صحيحة: "+right;
 $("badc").textContent="❌ خاطئة: "+wrong;
 $("msg").textContent=p>=90?"مبهر! أنت مؤرخ صغير بحق 👑":p>=70?"عمل رائع! اقتربت من القمة 🌟":p>=50?"جيد! راجع الدرس وجرّب مرة أخرى 💪":"لا بأس، المغامرة تبدأ من جديد. راجع الدرس وأعد المحاولة 📚";
 $("certTxt").textContent="تقديرًا لتفوقه في مغامرة «عصر الدولة الحديثة» وحصوله على "+score+" من "+n+" ("+p+"%)";
 syncName();show("end");
 tone([523,659,784,1047],.15);
}
function syncName(){$("certName").textContent=$("nameIn").value.trim()||"..................."}
$("nameIn").addEventListener("input",syncName);
$("startBtn").onclick=()=>{cur=score=right=wrong=0;show("game");render();tone([392,523],.1)};
$("nextBtn").onclick=()=>{cur++;cur<QUESTIONS.length?render():finish()};
$("muteBtn").onclick=()=>{muted=!muted;$("muteBtn").textContent=muted?"🔇":"🔊"};
$("printBtn").onclick=()=>window.print();
$("again").onclick=()=>{$("nameIn").value="";show("home")};
</script>
</body>
</html>
